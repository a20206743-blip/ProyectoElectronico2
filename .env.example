# Flask. FLASK_DEBUG debe permanecer false para la demo PE2.
FLASK_SECRET_KEY=
# 0.0.0.0 permite que el ESP32 llegue a la laptop por Wi-Fi.
# Con 127.0.0.1 solo funciona desde la propia laptop.
FLASK_HOST=0.0.0.0
FLASK_PORT=5050
FLASK_DEBUG=false

# Recepción Wi-Fi desde el módulo ESP32-C5.
# ESP32_DEVICE_KEY es opcional: si se define, el ESP32 debe
# enviar la misma clave en la cabecera X-Device-Key.
ESP32_RECEPTION_ROOT=data/esp32_reception
ESP32_DEVICE_KEY=
ESP32_MAX_FILE_MB=50
ESP32_ONLINE_SECONDS=15

# Integración de dron.
DRONE_TELEMETRY_STALE_SECONDS=5.0

# Persistencia. DB y campaigns deben respaldarse y restaurarse juntos.
DATABASE_URL=sqlite:///data/ground_control.db
CAMPAIGN_STORAGE_ROOT=data/campaigns

# Fotogrametría. Para demo usar PROCESSING_ENABLED=false.
PHOTOGRAMMETRY_BACKEND=MOCK
PROCESSING_ENABLED=false

# Navegación de exposición PE2.
PE2_DEMO_MODE=false

MOCK_PHOTOGRAMMETRY_DELAY_SECONDS=0

# Solo para procesamiento Metashape real.
METASHAPE_EXECUTABLE=

# Staging e importación RedEdge.
RED_EDGE_STAGING_ROOT=data/rededge_staging
RED_EDGE_UPLOAD_BATCH_MAX_FILES=25
RED_EDGE_STAGING_MAX_AGE_HOURS=24

# DJI Cloud API
DJI_CLOUD_APP_ID=
DJI_CLOUD_APP_KEY=
DJI_CLOUD_APP_LICENSE=

# Broker MQTT
DJI_MQTT_HOST=
DJI_MQTT_PORT=8883
DJI_MQTT_USERNAME=
DJI_MQTT_PASSWORD=